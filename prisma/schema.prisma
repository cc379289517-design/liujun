generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// 楼座表
// ============================================
model Building {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "1号楼"
  floorPlanUrl  String?  @map("floor_plan_url")
  cropX         Float?   @map("crop_x")
  cropY         Float?   @map("crop_y")
  cropW         Float?   @map("crop_w")
  cropH         Float?   @map("crop_h")
  extraVenues   String?  @map("extra_venues") // JSON array: ["化妆间","休息区"]
  rooms         Room[]
  profiles      Profile[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("buildings")
}

// ============================================
// 房间表
// ============================================
model Room {
  id          Int      @id @default(autoincrement())
  buildingId  Int      @map("building_id")
  roomNumber  String   @map("room_number")
  floor       Int      @default(1)
  xPosition   Float    @default(50) @map("x_position")
  yPosition   Float    @default(50) @map("y_position")
  fenceRadius Float    @default(5) @map("fence_radius")
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, roomNumber])
  @@map("rooms")
}

// ============================================
// 用户角色枚举
// ============================================
enum Role {
  photographer
  assistant
  assistant_leader
  admin
}

// ============================================
// 用户状态枚举
// 1:空闲(绿) 2:在忙(浅橙) 3:进行中(橙) 4:快结束(浅绿)
// ============================================
enum ProfileStatus {
  idle       // 1: 空闲 - 绿色
  assigned   // 2: 待就位 - 蓝色（已接收派发任务，未实际开始）
  busy       // 3: 在忙 - 浅橙
  executing  // 4: 进行中 - 橙色
  finishing  // 5: 快结束 - 浅绿
}

// ============================================
// 在线状态枚举
// ============================================
enum OnlineStatus {
  online
  offline
  on_break
}

// ============================================
// 用户状态表 (profiles)
// ============================================
model Profile {
  id            String        @id @default(uuid())
  employeeId    String?       @unique @map("employee_id")
  name          String
  avatar        String?
  password      String        @default("123456")
  role          Role
  department    String?
  group         String?       @map("group_name")
  buildingId    Int           @map("building_id")
  currentRoom   String?       @map("current_room")
  activeBuildingId Int?       @map("active_building_id")
  activeRoom    String?       @map("active_room")
  status        ProfileStatus @default(idle)
  subStatus     String?       @map("sub_status") // 微标签：上厕所、请假、身体不适
  eatingStartedAt DateTime?   @map("eating_started_at")
  eatingEndedAt   DateTime?   @map("eating_ended_at")
  onlineStatus  OnlineStatus  @default(online) @map("online_status")
  isOnline      Boolean       @default(true) @map("is_online")
  building      Building      @relation(fields: [buildingId], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // 关系
  createdTasks  BookingTask[] @relation("TaskPhotographer")
  assignedTasks BookingTask[] @relation("TaskAssistant")
  collaboratedTasks TaskCollaborator[]

  @@map("profiles")
}

// ============================================
// 任务状态枚举
// ============================================
enum TaskStatus {
  waiting    // 等待分配/执行
  executing  // 执行中
  paused     // 暂停（被插单等）
  completed  // 已完成
}

// ============================================
// 任务类型配置表
// ============================================
model TaskCategory {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "短时手持", "服装穿戴"
  description   String?
  priorityLevel Int      @map("priority_level") // 1-4
  minDuration   Int      @map("min_duration")   // 最小时长(分钟)
  maxDuration   Int      @map("max_duration")   // 最大时长(分钟)
  estDuration   Int      @default(10) @map("est_duration") // 预估时长(分钟)
  hexColor      String   @default("#f97316") @map("hex_color") // 状态环颜色
  sortRank      Int      @default(0) @map("sort_rank") // 排序权重
  canBeInterrupted  Boolean @default(true) @map("can_be_interrupted") // 该类型任务是否可被P1打断
  maxInterruptMinutes Int? @map("max_interrupt_minutes") // 允许插单的最大离场时间(分钟)，null使用全局默认
  tasks         BookingTask[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("task_categories")
}

// ============================================
// 系统全局配置表
// ============================================
model SystemConfig {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ============================================
// 任务预约表 (booking_tasks)
// ============================================
model BookingTask {
  id              String      @id @default(uuid())
  photographerId  String      @map("photographer_id")
  assistantId     String?     @map("assistant_id")
  locationBuildingId Int?     @map("location_building_id")
  roomNumber      String      @map("room_number")
  categoryId      Int         @map("category_id")
  priority        Int         @default(4) // 动态优先级 1-4
  isLocked        Boolean     @default(false) @map("is_locked")
  lockReason      String?     @map("lock_reason")
  isSpecified     Boolean     @default(false) @map("is_specified")
  estEndTime      DateTime?   @map("est_end_time")
  status          TaskStatus  @default(waiting)
  note            String?     // 特殊备注（带小推车、工具等）
  publisherFeedback String?   @map("publisher_feedback") // 摄影师任务发布明细反馈：like / dislike

  // 时间戳
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  pausedAt        DateTime?   @map("paused_at")  // 被插单暂停的时间点
  escalatedAt     DateTime?   @map("escalated_at") // 最后一次提权时间
  escalatedFromPriority Int?  @map("escalated_from_priority") // 第一次提权前的原始优先级

  // 有效执行时长：仅统计 executing 片段；暂停/待就位/插单间隔不计入
  effectiveWorkSeconds Int       @default(0) @map("effective_work_seconds")
  workSegmentStartedAt DateTime?   @map("work_segment_started_at") // 当前 executing 片段起点

  // 插单相关
  parentTaskId    String?     @map("parent_task_id") // 被插单的原任务
  parentTask      BookingTask? @relation("TaskInterrupt", fields: [parentTaskId], references: [id])
  interruptTasks  BookingTask[] @relation("TaskInterrupt")
  collaborators   TaskCollaborator[]
  standbyReassignmentNotices StandbyReassignmentNotice[]

  // 关系
  photographer    Profile      @relation("TaskPhotographer", fields: [photographerId], references: [id])
  assistant       Profile?     @relation("TaskAssistant", fields: [assistantId], references: [id])
  category        TaskCategory @relation(fields: [categoryId], references: [id])

  @@index([status, priority])
  @@index([assistantId, status])
  @@index([photographerId])
  @@index([locationBuildingId])
  @@map("booking_tasks")
}

model StandbyReassignmentNotice {
  id                       String    @id @default(uuid())
  taskId                   String    @map("task_id")
  oldAssistantId           String    @map("old_assistant_id")
  oldAssistantName         String    @map("old_assistant_name")
  newAssistantId           String    @map("new_assistant_id")
  newAssistantName         String    @map("new_assistant_name")
  taskRoomNumber           String    @map("task_room_number")
  taskCategoryName         String    @map("task_category_name")
  taskPriority             Int       @map("task_priority")
  waitedMinutes            Int       @map("waited_minutes")
  thresholdMinutes         Int       @map("threshold_minutes")
  score                    Int
  reason                   String    @default("standby_timeout_offline")
  oldAssistantSetOffline   Boolean   @default(true) @map("old_assistant_set_offline")
  oldAssistantActiveTaskRoomNumber String? @map("old_assistant_active_task_room_number")
  oldAssistantActiveTaskCategoryName String? @map("old_assistant_active_task_category_name")
  oldAssistantActiveTaskStatus String? @map("old_assistant_active_task_status")
  newAssistantAcknowledgedAt DateTime? @map("new_assistant_acknowledged_at")
  oldAssistantAcknowledgedAt DateTime? @map("old_assistant_acknowledged_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  task BookingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([newAssistantId, newAssistantAcknowledgedAt])
  @@index([oldAssistantId, oldAssistantAcknowledgedAt])
  @@index([taskId])
  @@map("standby_reassignment_notices")
}

// ============================================
// 任务协作助理表
// ============================================
model TaskCollaborator {
  id          String      @id @default(uuid())
  taskId      String      @map("task_id")
  assistantId String      @map("assistant_id")
  role        String      @default("helper")
  status      String      @default("waiting")
  joinedAt    DateTime    @default(now()) @map("joined_at")
  leftAt      DateTime?   @map("left_at")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  effectiveWorkSeconds Int       @default(0) @map("effective_work_seconds")
  workSegmentStartedAt DateTime? @map("work_segment_started_at")

  task      BookingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assistant Profile     @relation(fields: [assistantId], references: [id])

  @@unique([taskId, assistantId])
  @@index([assistantId, status])
  @@index([taskId, status])
  @@map("task_collaborators")
}
